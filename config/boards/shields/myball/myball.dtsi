/*
 * myball.dtsi
 * 左右で共通のキーマトリクス定義(3行 x 5列 + 親指2キー = 片側17キー)
 *
 * ★ 重要 ★
 * row-gpios / col-gpios のピン番号は「仮の値」です。
 * 実際の配線(どのマイコンピンがどの行/列に繋がっているか)に
 * 合わせて必ず書き換えてください。
 *
 * ここでは nice!nano の Pro Micro 互換ピン番号(0〜21)で
 * 指定する書き方を使っています。
 *   例: &pro_micro 1  は Pro Micro でいうピン「1」に相当
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
                RC(3,1) RC(3,2)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        // ---- 行 (4行) : ここを実配線に合わせて変更 ----
        row-gpios
            = <&pro_micro 0 GPIO_ACTIVE_HIGH>
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>
            ;

        // ---- 列 (5列) : ここを実配線に合わせて変更 ----
        col-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            ;
    };
};
